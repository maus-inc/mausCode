    "env": {
      "TZ": "America/New_York"
    }
  },
  "docs-probe": {
    "url": "https://mcp.example.com/mcp",
    "transport": "streamable-http",
    "headers": {
      "Authorization": "Bearer REDACTED-FIXTURE"
    }
  }
}
