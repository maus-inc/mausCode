{
  "$schema": "https://biomejs.dev/schemas/2.5.13/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "asNeeded",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error",
        "noUnusedFunctionParameters": "error",
        "useExhaustiveDependencies": "error",
        "useHookAtTopLevel": "error"
      },
      "style": {
        "noNonNullAssertion": "error",
        "useTemplate": "error",
        "useNodejsImportProtocol": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noArrayIndexKey": "error",
        "useIterableCallbackReturn": "error",
        "noControlCharactersInRegex": "error",
        "noImplicitAnyLet": "error"
      },
      "a11y": {
        "useButtonType": "error",
        "noSvgWithoutTitle": "error",
        "noStaticElementInteractions": "error",
        "noLabelWithoutControl": "error",
        "useKeyWithClickEvents": "error",
        "noNoninteractiveTabindex": "error"
      },
      "complexity": {
        "useOptionalChain": "error",
        "noUselessFragments": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/_generated/**"],
      "formatter": {
        "enabled": false
      },
      "linter": {
        "enabled": false
      },
      "assist": {
        "enabled": false
      }
    }
  ],
  "files": {
    "includes": [
      "**",
      "!**/out",
      "!**/release",
      "!release-*",
      "!drizzle/meta",
      "!resources/bin",
      "!build",
      "!coverage",
      "!**/new mauscode branding",
      "!.merge-backup",
      "!**/.merge-backup",
      "!.agents/skills",
      "!runtime/jcode"
    ]
  }
}
